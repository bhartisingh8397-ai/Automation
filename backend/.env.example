# DIGIAUTO Social Media Automation Environment Configuration

SECRET_KEY=digiauto-secret-key-2026-prod

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=digiauto_db

SCHEDULER_INTERVAL_SECONDS=10
OPENAI_API_KEY=

# YouTube Data API v3 & Google OAuth Credentials
YOUTUBE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_client_secret_here
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/youtube/oauth2callback

# Meta (Facebook & Instagram) Graph API Credentials
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_REDIRECT_URI=http://localhost:5000/api/meta/oauth2callback
